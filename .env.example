# ==============================================================================
# ResQ AI Environment Configuration Template
# NOTE: Never commit sensitive keys or actual credentials to version control.
# ==============================================================================

# Server Network Configuration
PORT=3001
NODE_ENV=development

# CORS allowlist: comma-separated list of trusted frontend origins.
# Only the exact origins listed here are accepted (wildcards are never allowed).
# If left unset, the backend falls back to local-development defaults:
#   http://localhost:5173, http://localhost:5174, http://localhost:4173
#   (plus their 127.0.0.1 equivalents)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Server-side authorization token for destructive admin endpoints
# (POST /api/incidents/reset-demo and DELETE /api/activity).
# Send it as `Authorization: Bearer <token>` or `X-Admin-Token: <token>`.
# If unset: in development the endpoints warn and stay open; in production
# they return 503 until a token is configured.
ADMIN_TOKEN=

# Google Gemini API (Server-Only - Never expose to frontend or client bundle)
# Obtain a key from Google AI Studio: https://aistudio.google.com/
# Leave empty to run in zero-credential Simulated Demonstration Mode.
GEMINI_API_KEY=

# Gemini Model Identifier (Must be official model name)
GEMINI_MODEL=gemini-2.5-flash

# Persistence Store Mode ('json' for local file persistence or 'memory' for ephemeral)
STORAGE_TYPE=json
REAL_DATA_PATH=./data/incidents.json
DEMO_DATA_PATH=./data/demo_incidents.json

# File Upload Security Quotas (Bytes) - Default 10MB
MAX_UPLOAD_SIZE_BYTES=10485760

# Optional: Google Maps Platform API Key (for geocoding enhancement)
# If omitted, ResQ AI uses an accessible structured text location fallback.
GOOGLE_MAPS_API_KEY=
